<!DOCTYPE html>
<html>
<head>
  <title>URL ANALYTICS</title>
  <link rel="stylesheet" href="/css/analytics.css">
</head>
<body>
   <h1>URL ANALYTICS</h1>
   <div class="table-container">
     <table>
       <thead>
         <tr>
           <th>S.NO</th>
           <th>SHORT URL</th>
           <th>REDIRECT URL</th>
           <th>TOTAL CLICKS</th>
         </tr>
       </thead>
       <tbody>
          <% locals.urls.forEach((url,index)=>{ %>
           <tr>
             <td><%=index+1%></td>
             <td><%=url.shortId%></td>
             <td><%=url.redirectURL %></td>
             <td><%=url.visitHistory.length %></td>
           </tr>
           <% })%>
       </tbody>
     </table>
   </div>
</body>
</html>
