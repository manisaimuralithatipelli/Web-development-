<!DOCTYPE html>
<html lang="en">
<head>
    <title>URL Analytics</title>
    <link rel="stylesheet" href="/css/analyticsid.css">
</head>
<body>
    <div class="container">
         <h1 class="heading">URL ANALYTICS</h1>
         <div class="analytics-row">
             <div class="analytics-box">
                 <h2>SHORT ID:</h2>
                 <strong><%=url.shortId%></strong>
             </div>
     <div class="analytics-box">
                 <h2>TOTAL CLICKS:</h2>
                 <strong><%=url.visitHistory.length%></strong>
             </div>
         </div>
          <div class="analytics-box2">
              <h2>REDIRECT URL:</h2>
              <strong><%= url.redirectURL%></strong>
          </div>
         <div class="analytics-box history-box">

            <h2>Visit History</h2>

            <table>
                <thead>
                    <tr>
                        <th>S.NO</th>
                        <th>Timestamp</th>
                    </tr>
                </thead>

                <tbody>
                    <% url.visitHistory.forEach((visit, index) => { %>

                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= visit.timestamp %></td>
                        </tr>

                    <% }) %>
                </tbody>
            </table>

        </div>

    </div>
</body>
</html>
