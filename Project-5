<!DOCTYPE html>  <html>  
<head>  
  <meta charset="UTF-8">  
  <meta name="viewport" content="width=device-width, initial-scale=1">  
  <title>Grid</title>  
<style>  
  .grid-container{  
    display:grid;  
    grid-template-columns: auto auto auto;  
    height:400px;  
    gap:30px;  
  }  
  .card{  
    background:#f4f4f4;  
    width:250px;  
  }  
  .card p,h3{  
    text-align: center;  
  }  
  button{  
  border:none;  
  padding:6px;  
  color:#fff;  
  font-size:12px;  
  }  
  .btn-group{  
    display:grid;  
    grid-template-columns:1fr 1fr;
    gap:10px;  
  }  
   .btn-32{  
     background:#00D8FF;  
     justify-self:start;   
     border-radius:10px;  
  }  
   .btn-64{  
    background:#5cb85c;  
    justify-self:end;   
    border-radius:10px;  
  }  
</style>  
</head>  
<body>  
    <div class="grid-container">  <div class="card">  
  <h3>English</h3>  
  <p>English</p>  
  <div class="btn-group">  
    <button class="btn btn-32">Download 32-bit</button>  
    <button class="btn btn-64">Download 64-bit</button>  
  </div>  
</div>  

